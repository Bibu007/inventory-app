<!doctype html>
<html lang="en">
  <%- include ('./partials/head.ejs') %>
  <body>
    <%- include ('./partials/header.ejs') %>
    <main>
      <div class="title-container">
        <h2 class="title">CATEGORIES</h2>
        <a href="/categories/add" class="add-game">+ Add category</a>
      </div>
      <table class="table-container">
        <tr class="row header">
          <th class="row-item">Name</th>
          <th class="row-item">Action</th>
        </tr>
          <% if(categories.length > 0){ %>
        <% categories.forEach(category =>  { %>
          <tr class="row">
          <td class="row-item"><%= category.name %></td>
          <td class="'row-item"><button data-doc="<%= category.id %>" class="delete" <%= check(category.id) ? 'disabled' : '' %>>Delete</button></td>
          </tr>
        <%  }) %>
        <% } %>
        
        </table>
        <p class="warning">You can only delete a category if no games belong to that category</p>
    </main>
    <script>
        const table = document.querySelector('.table-container');
        //console.log("Hey");
        table.addEventListener('click', (e) => {
            const endpoint = `/categories/delete/${e.target.dataset.doc}`;
            //console.log(`Endpoint: ${endpoint}`)
            window.location.href = `${endpoint}`;
        })
    </script>
  </body>
</html>