<!doctype html>
<html lang="en">
  <%- include ('./partials/head.ejs') %>
  <body>
    <%- include ('./partials/header.ejs') %>
    <form action="/games/edit" method="POST">
        <input type="hidden" name="id" value="<%= formData.id %>">
      <p class="form-item">
        <label for="name">Name: </label>
        <input type="text" name="name" id="name" value="<%= formData?.name || '' %>" required />
      </p>
      <p class="form-item">
        <label for="platform">Platform: </label>
        <input type="text" name="platform" id="platform" value="<%= formData?.platform || '' %>" required />
      </p>
      <p class="form-item">
        <label for="release">Release year: </label>
        <input type="text" name="release" id="release" value="<%= formData?.release_year || '' %>" required />
      </p>
      <p class="form-item">
        <label for="price">Price: </label>
        <input type="text" name="price" id="price" value="<%= formData?.price || '' %>" required />
      </p>
      <p class="form-item">
        <label for="stock">Stock quantity: </label>
        <input type="text" name="stock" id="stock" value="<%= formData?.stock_quantity || '' %>" required />
      </p>
      <p class="form-item">
        <label for="category">Category: </label>
        <select name="category" id="category" multiple required>
            <% if(categories.length > 0){ %>
        <% categories.forEach(category =>  { %>
            <option value="<%= category.name  %>" <%= selectedCat.includes(category.id) ? 'selected' : '' %>><%= category.name %></option>
        <%  }) %>
        <% } %>
        </select>
        <span class="note">Press Ctrl/command to select multiple options</span>
      </p>
      <p class="form-item">
        <label for="developer">Developer: </label>
        <select name="developer" id="developer" required>
            <% if(developers.length > 0){ %>
        <% developers.forEach(developer =>  { %>
            <option value="<%= developer.name  %>" <%= developer.id === selectedDeveloper[0].supplier_id ? 'selected' : '' %>><%= developer.name %></option>
        <%  }) %>
        <% } %>
        </select>
      </p>
      <button type="submit">Edit</button>
      <%- include("partials/errors.ejs") %>
    </form>
  </body>
</html>
