<!doctype html>
<html lang="en">
  <%- include ('./partials/head.ejs') %>
  <body>
    <%- include ('./partials/header.ejs') %>
    <main>
      <div class="title-container">
        <h2 class="title">GAMES</h2>
        <a href="/games/add" class="add-game">+ Add game</a>
      </div>
      <table>
        <tr class="row header">
          <th class="row-item">Name</th>
          <th class="row-item">Cost</th>
          <th class="row-item">Count</th>
          <th class="row-item">Category</th>
          <th class="row-item">Developer</th>
          <th class="row-item"></th>
        </tr>
          <% if(games.length > 0){ %>
        <% games.forEach(game =>  { %>
          <tr class="row">
          <td class="row-item"><%= game.name %></td>
          <td class="row-item"><%= game.price %></td>
          <td class="row-item"><%= game.stock_quantity %></td>
          <td class="row-item"><%= game.categories %></td>
          <td class="row-item"><%= game.suppliers %></td>
          <td class="row-item"><a href="/games/edit/<%= game.id %>" class="edit" data-doc=<%= game.id %>>Edit</a><a href="/games/delete/<%= game.id %>" class="delete" data-doc=<%= game.id %>>Delete</a></td>
          </tr>
        <%  }) %>
        <% } %>
        
        </table>
    </main>
  </body>
</html>
