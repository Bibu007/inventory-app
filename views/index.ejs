<!doctype html>
<html lang="en">
  <%- include ('./partials/head.ejs') %>
  <body>
    <%- include ('./partials/header.ejs') %>
    <main>
      <div class="title-container">
        <h2 class="title">GAMES</h2>
        <a href="/games/add" class="add-game">+ Add game</a>
      </div>
      <table class="table-container">
        <tr class="row header">
          <th class="row-item">Name</th>
          <th class="row-item">Cost</th>
          <th class="row-item">Count</th>
          <th class="row-item">Category</th>
          <th class="row-item">Developer</th>
          <th class="row-item"></th>
        </tr>
          <% if(games.length > 0){ %>
        <% games.forEach(game =>  { %>
          <tr class="row">
          <td class="row-item"><%= game.name %></td>
          <td class="row-item"><%= game.price %></td>
          <td class="row-item"><%= game.stock_quantity %></td>
          <td class="row-item"><%= game.categories %></td>
          <td class="row-item"><%= game.suppliers %></td>
          <td class="row-item"><button class="edit" data-doc="<%= game.id %>">Edit</button><button class="delete" data-doc="<%= game.id %>">Delete</button></td>
          </tr>
        <%  }) %>
        <% } %>
        
        </table>
        <dialog class="delete-confirm">
                <h3>Confirm delete?</h3>
                <p> Are you sure you want to delete this item?</p>
                <button class="yes">Yes</button>
                <button class="no">No</button>
    </main>
    <script>
        const editBtn = document.querySelector('.table-container');
        //console.log("Hey");
        editBtn.addEventListener('click', (e) => {
            if(e.target.className === "edit"){
            const endpoint = `/games/edit/${e.target.dataset.doc}`;
            console.log(`Endpoint: ${endpoint}`)
            window.location.href = `${endpoint}`;
            }
            else if(e.target.className === "delete"){
                const dialog = document.querySelector('.delete-confirm');
                const endpoint = `/games/delete/${e.target.dataset.doc}`;
                dialog.showModal();
                const yes = document.querySelector('.yes');
                const no = document.querySelector('.no');

                yes.addEventListener('click', (e) => {
                    window.location.href = `${endpoint}`;
                })

                no.addEventListener('click', (e) => {
                    dialog.close();
                })
            }
        })
    </script>
  </body>
</html>
