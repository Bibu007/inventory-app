<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flopstar Games | <%= title %></title>
  <style>
    body {
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Oxygen,
        Ubuntu,
        Cantarell,
        "Open Sans",
        "Helvetica Neue",
        sans-serif;
    }
    header {
      display: flex;
      justify-content: space-between;
      margin: 10px 20px;
      flex-wrap: wrap;
    }
    a {
      color: grey;
    }
    .message {
      padding: 10px 200px;
      margin: auto;
    }
    .message p {
      font-size: 1.25rem;
    }
    .message h2 {
      color: red;
    }

    .message-details {
      display: flex;
      justify-content: space-between;
      padding: 10px 100px;
    }
    .date {
      color: gray;
    }
    .date p {
      font-size: 0.8rem;
    }
    form {
      display: grid;
      gap: 20px;
      padding-left: 200px;
      font-size: 1.25rem;
    }
    label {
      min-width: 200px;
    }
    input,
    select {
      min-width: 300px;
      border-radius: 10px;
      padding: 10px;
      font-size: 1rem;
    }
    .form-item {
      width: 200px;
      display: flex;
      justify-content: space-between;
    }
    form button {
      width: 100px;
      font-size: 1.5rem;
      padding: 10px;
      border-radius: 10px;
      color: white;
      background-color: red;
    }
    .note {
      font-size: 0.8rem;
      margin-left: 10px;
      min-width: 200px;
    }
    nav {
      display: flex;
      gap: 50px;
    }
    .logo {
      color: orange;
      min-width: 280px;
    }

    .row.header {
      font-size: 1.2rem;
      font-weight: 800;
    }
    table {
      border: 1px solid black;
      width: 100%;
      text-align: center;
      border-collapse: collapse;
    }
    .title-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-decoration: none;
    }
    a {
      text-decoration: none;
    }
    .title {
      color: rgb(156, 64, 242);
      margin: 20px;
    }
    .add-game {
      background-color: inherit;
      border: none;
      color: rgb(45, 116, 237);
      font-weight: 800;
      font-size: 1.2rem;
      margin-right: 20px;
    }
    .add-game:active {
      transform: translateY(2px);
    }
    th {
      background-color: aquamarine;
      padding: 10px;
      border: 1px solid black;
    }
    td {
      border: 1px solid black;
      padding: 5px;
    }
    .delete {
      background-color: inherit;
      border: none;
      color: red;
      font-weight: 800;
      font-size: 1rem;
      margin-right: 20px;
      margin-left: 20px;
    }
    .edit {
      color: green;
      font-weight: 800;
      font-size: 1rem;
      margin-right: 20px;
      margin-left: 20px;
    }
    .delete:active,
    .edit:active {
      transform: translateY(2px);
    }
  </style>
</head>
